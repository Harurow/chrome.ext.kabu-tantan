{
  "name": "chrome.ext.kabu-tantan",
  "version": "1.21.0",
  "private": true,
  "description": "証券会社サイトから外部の株式情報ページへ遷移するリンクを追加する Chrome 拡張機能「株リンク」",
  "homepage": "https://github.com/Harurow/chrome.ext.kabu-tantan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harurow/chrome.ext.kabu-tantan.git"
  },
  "author": "www.harurow",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:md",
    "fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix && markdownlint-cli2 --fix \"docs/**/*.md\" \"*.md\" \".claude/**/*.md\"",
    "validate": "node scripts/validate-manifest.mjs",
    "package": "node scripts/package.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "check": "node scripts/check.mjs",
    "check:steps": "npm run lint:all && npm run validate && npm test && npm run docs:tests:check",
    "docs:tests": "node scripts/test-catalog.mjs",
    "approve": "node scripts/approve.mjs",
    "docs:tests:check": "node scripts/test-catalog.mjs --check",
    "check:selectors": "node scripts/selector-check/index.mjs",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\" \"*.md\" \".claude/**/*.md\""
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "eslint": "^9.39.5",
    "markdownlint-cli2": "^0.23.2",
    "neostandard": "^0.13.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1"
  }
}
